# ytdlp-web environment file.
# Copy this file to /etc/yt-dlp-web/ytdlp-web.env. Set the owner to root and the mode to 600.
#   install -o root -g root -m 600 ytdlp-web.env.example /etc/yt-dlp-web/ytdlp-web.env
# Edit /etc/yt-dlp-web/ytdlp-web.env after the copy, and set a real password.
# Restart the service after every change:
#   systemctl restart ytdlp-web

# The login password for the web page. This value is required.
# Generate a strong password with this command, then paste the output here:
#   openssl rand -base64 24
YTDLP_WEB_PASSWORD=change-me

# The address the application binds to.
# Keep 127.0.0.1, because nginx is the only client. Port 8000 must stay closed from outside.
YTDLP_WEB_HOST=127.0.0.1

# The TCP port the application listens on. The nginx site file uses the same port.
YTDLP_WEB_PORT=8000

# The directory for the download work files. The ytdlp user must own it.
# The systemd unit gives write access to /var/lib/ytdlp-web only.
YTDLP_WEB_TEMP_ROOT=/var/lib/ytdlp-web/work

# The largest file the application accepts, in bytes. This value is 2 GB.
YTDLP_WEB_MAX_FILESIZE=2147483648

# How many jobs run at the same time. One job keeps the disk use predictable.
YTDLP_WEB_MAX_JOBS=1

# How long a finished file stays on disk, in seconds. This value is 10 minutes.
YTDLP_WEB_TTL=600
