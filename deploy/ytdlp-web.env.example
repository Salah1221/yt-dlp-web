# ytdlp-web environment file.
# Copy this file to /etc/yt-dlp-web/ytdlp-web.env. Set the owner to root and the mode to 600.
#   install -o root -g root -m 600 ytdlp-web.env.example /etc/yt-dlp-web/ytdlp-web.env
# Edit /etc/yt-dlp-web/ytdlp-web.env after the copy, and set a real password.
# Restart the service after every change:
#   systemctl restart ytdlp-web

# The login password for the web page. This value is required.
# Generate a strong password with this command, then paste the output here:
#   openssl rand -base64 24
YTDLP_WEB_PASSWORD=change-me

# The address the application binds to.
# Keep 127.0.0.1, because nginx is the only client. Port 8000 must stay closed from outside.
YTDLP_WEB_HOST=127.0.0.1

# The TCP port the application listens on. The nginx site file uses the same port.
YTDLP_WEB_PORT=8000

# The directory for the download work files. The ytdlp user must own it.
# The systemd unit gives write access to /var/lib/ytdlp-web only.
YTDLP_WEB_TEMP_ROOT=/var/lib/ytdlp-web/work

# The largest file the application accepts, in bytes. This value is 2 GB.
YTDLP_WEB_MAX_FILESIZE=2147483648

# How many jobs run at the same time. One job keeps the disk use predictable.
YTDLP_WEB_MAX_JOBS=1

# How long a finished file stays on disk, in seconds. This value is 10 minutes.
YTDLP_WEB_TTL=600

# A cookies.txt file, exported from a browser that is signed in to the video site.
# Set this when the site answers with "Sign in to confirm you're not a bot".
# The steps are in docs/cookies.md. The file holds a live session, so place it like this:
#   install -o root -g ytdlp -m 640 cookies.txt /etc/yt-dlp-web/cookies.txt
# Leave the line out when you have no such file. A named file that is absent stops the start.
# The Settings panel on the page does the same job without this file, and its copy wins.
#YTDLP_WEB_COOKIES=/etc/yt-dlp-web/cookies.txt

# Where the Settings panel saves the cookies that somebody pastes into the page.
# It must sit inside /var/lib/ytdlp-web, which is the one path the systemd unit may write.
# The default is /var/lib/ytdlp-web/work/cookies.txt, beside the job folders.
YTDLP_WEB_COOKIE_STORE=/var/lib/ytdlp-web/cookies.txt

# The JavaScript runtimes yt-dlp may use for YouTube, with an optional path after a colon.
# Leave this out unless the runtime is somewhere unusual: the application finds deno,
# node, quickjs, or bun by itself, and says at startup which one it took.
# Without one, YouTube serves almost nothing and a download ends with
# "Requested format is not available". See section 11 of deploy/README.md to install deno.
# Note that yt-dlp needs node 22 or later, so the node in Debian 12 does not count.
# This list replaces the default, so naming node turns deno off.
#YTDLP_WEB_JS_RUNTIMES=node:/opt/node22/bin/node

# The YouTube clients to ask, in order. Leave this out: the application asks for the
# clients that need no proof token, which is what a server can use at all.
# Set it to "default" only on a server where a plugin mints that token, which opens
# the rest of the clients again. See docs/cookies.md.
#YTDLP_WEB_PLAYER_CLIENT=default
